menu "Audio Locator Configuration"

    config AUDIO_LOCATOR_ENABLE
        bool "Enable Audio Locator"
        default y
        help
            Enable sound source localization using dual I2S MEMS
            microphones (INMP441) with TDOA-based direction estimation.

    config AUDIO_LOCATOR_I2S_BCK
        int "I2S Bit Clock GPIO"
        range 0 48
        default 4
        help
            GPIO number for the I2S bit clock (shared by both mics).

    config AUDIO_LOCATOR_I2S_WS
        int "I2S Word Select GPIO"
        range 0 48
        default 5
        help
            GPIO number for the I2S word select / LR clock.

    config AUDIO_LOCATOR_I2S_DIN_LEFT
        int "Left Mic I2S Data GPIO"
        range 0 48
        default 6
        help
            GPIO number for the left-channel INMP441 I2S data input.

    config AUDIO_LOCATOR_I2S_DIN_RIGHT
        int "Right Mic I2S Data GPIO"
        range 0 48
        default 7
        help
            GPIO number for the right-channel INMP441 I2S data input.

    config AUDIO_LOCATOR_SAMPLE_RATE
        int "Audio Sample Rate (Hz)"
        default 16000
        range 8000 48000
        help
            Sample rate for I2S microphone input. 16kHz is sufficient
            for sound localization.

endmenu
